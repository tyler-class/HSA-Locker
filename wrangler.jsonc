{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hsa-locker",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  // Needed for OAuth clients that identify themselves with a metadata URL.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    // Static SPA. Unknown paths fall back to index.html; API and MCP always reach the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/oauth/*", "/.well-known/*"],
  },
  "d1_databases": [
    {
      // No database_id: the Deploy button and `wrangler deploy` provision it automatically.
      "binding": "DB",
      "database_name": "hsa-locker",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      // Original receipts, EOBs and the emails they arrived in. Private: served only through
      // /api/files/:id to signed-in users. No bucket_name: provisioned automatically on deploy.
      "binding": "FILES",
    },
  ],
  "kv_namespaces": [
    {
      // Sign-ins for AI assistants connected over MCP. Provisioned automatically on deploy.
      "binding": "OAUTH_KV",
    },
  ],
  // Workers AI reads documents. Always runs on Cloudflare, even in `npm run dev`.
  "ai": { "binding": "AI" },
  // Picks up documents waiting to be read, stuck, or due for a retry.
  "triggers": { "crons": ["*/10 * * * *"] },
}
